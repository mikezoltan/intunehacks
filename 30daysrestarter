# SimpleTimer
function Show-CountdownSimple {
    param(
        [int]$Seconds = 60,
        [string]$Title = "Újraindítás hamarosan",
        [string]$Message = "A gép rövidesen újraindul!"
    )

    Add-Type -AssemblyName System.Windows.Forms, System.Drawing | Out-Null

    $form = New-Object System.Windows.Forms.Form
    $form.Text = $Title
    $form.Size = New-Object System.Drawing.Size(300,150)
    $form.StartPosition = "CenterScreen"
    $form.TopMost = $true
    $form.FormBorderStyle = 'FixedDialog'
    $form.ControlBox = $false

    $label = New-Object System.Windows.Forms.Label
    $label.Text = $Message
    $label.AutoSize = $true
    $label.Location = New-Object System.Drawing.Point(20,20)
    $form.Controls.Add($label)

    $counter = New-Object System.Windows.Forms.Label
    $counter.Font = New-Object System.Drawing.Font("Segoe UI",20,[System.Drawing.FontStyle]::Bold)
    $counter.AutoSize = $true
    $counter.Location = New-Object System.Drawing.Point(110,60)
    $form.Controls.Add($counter)

    $timer = New-Object System.Windows.Forms.Timer
    $timer.Interval = 1000

    $remaining = $Seconds
    $counter.Text = $remaining

    $timer.Add_Tick({
        $remaining--
        $counter.Text = $remaining
        if ($remaining -lt 0) {
            $timer.Stop()
            $form.Close()
        }
    })

    $form.Add_Shown({ $timer.Start() })
    $form.ShowDialog() | Out-Null
}
# Timer
function Show-RestartCountdownWinForms {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [int]$Seconds,
        [string]$Title        = "Értesítés újraindításról",
        [string]$Message      = "Kérem mentse folyamatban lévő munkáit!",
        [int]$SnoozeMinutes   = 5,
        [switch]$TopMost
    )

    # Ha nem STA runspace-ben futunk, indítsuk külön STA-ban
    if ($Host.Runspace.ApartmentState -ne 'STA') {
        
$ps = [powershell]::Create()
        $rs = [runspacefactory]::CreateRunspace()
        $rs.ApartmentState = "STA"
        $rs.ThreadOptions  = "ReuseThread"
        $rs.Open()

        $ps.Runspace = $rs
        $ps.AddScript(${function:Show-RestartCountdownWinForms}.ToString()) | Out-Null
        
        $cmd = "Show-RestartCountdownWinForms -Seconds $Seconds -Title '$Title' -Message '$Message' -SnoozeMinutes $SnoozeMinutes " + ($(if ($TopMost) {'-TopMost'}))
        $ps.AddScript($cmd) | Out-Null

        $result = $ps.Invoke()
        $ps.Dispose(); $rs.Close()
        return $result
    }

    }

    Add-Type -AssemblyName System.Windows.Forms, System.Drawing | Out-Null

    # Panel elhelyezése: jobb-alsó sarok
    $wa     = [System.Windows.Forms.Screen]::PrimaryScreen.WorkingArea
    $width  = 380
    $height = 300
    $posX   = $wa.Right  - $width  - 20
    $posY   = $wa.Bottom - $height - 20

    $form = New-Object System.Windows.Forms.Form
    $form.Text            = $Title
    $form.Size            = [System.Drawing.Size]::new($width,$height)
    $form.StartPosition   = 'Manual'
    $form.Location        = [System.Drawing.Point]::new($posX,$posY)
    $form.TopMost         = [bool]$TopMost
    $form.FormBorderStyle = 'FixedToolWindow'
    $form.ControlBox      = $false
    $form.AutoScaleMode   = [System.Windows.Forms.AutoScaleMode]::Dpi
    $form.ShowInTaskbar   = $false

    # Üzenet
    $label = New-Object System.Windows.Forms.Label
    $label.Text     = $Message
    $label.Font     = New-Object System.Drawing.Font('Segoe UI',11,[System.Drawing.FontStyle]::Bold)
    $label.AutoSize = $true
    $label.Location = [System.Drawing.Point]::new(20,15)
    $form.Controls.Add($label)

    # Számláló blokk
    $groupRestart = New-Object System.Windows.Forms.GroupBox
    $groupRestart.Location = [System.Drawing.Point]::new(15,45)
    $groupRestart.Size     = [System.Drawing.Size]::new(330,120)
    $form.Controls.Add($groupRestart)

    $labelPrefix = New-Object System.Windows.Forms.Label
    $labelPrefix.Text     = "Hátralévő idő:"
    $labelPrefix.AutoSize = $true
    $labelPrefix.Font     = New-Object System.Drawing.Font('Segoe UI',12)
    $labelPrefix.Location = [System.Drawing.Point]::new(15,30)
    $groupRestart.Controls.Add($labelPrefix)

    $labelTime = New-Object System.Windows.Forms.Label
    $labelTime.Text     = "00:00"
    $labelTime.AutoSize = $true
    $labelTime.Font     = New-Object System.Drawing.Font('Segoe UI',12,[System.Drawing.FontStyle]::Bold)
    $labelTime.Location = [System.Drawing.Point]::new(160,30)
    $groupRestart.Controls.Add($labelTime)

    $progress = New-Object System.Windows.Forms.ProgressBar
    $progress.Location = [System.Drawing.Point]::new(15,65)
    $progress.Size     = [System.Drawing.Size]::new(300,20)
    $progress.Minimum  = 0
    $progress.Maximum  = $Seconds
    $progress.Value    = $Seconds
    $groupRestart.Controls.Add($progress)

    # Gombok
    $btnRestart = New-Object System.Windows.Forms.Button
    $btnRestart.Text     = "Újraindítás most"
    $btnRestart.Size     = [System.Drawing.Size]::new(120,30)
    $btnRestart.Location = [System.Drawing.Point]::new(20,180)

    $btnSnooze = New-Object System.Windows.Forms.Button
    $btnSnooze.Text     = "Halasztás (${SnoozeMinutes} perc)"
    $btnSnooze.Size     = [System.Drawing.Size]::new(140,30)
    $btnSnooze.Location = [System.Drawing.Point]::new(150,180)

    $btnCancel = New-Object System.Windows.Forms.Button
    $btnCancel.Text     = "Mégse"
    $btnCancel.Size     = [System.Drawing.Size]::new(80,30)
    $btnCancel.Location = [System.Drawing.Point]::new(295,180)

    $form.Controls.AddRange(@($btnRestart,$btnSnooze,$btnCancel))

    # Eredmény és számláló
    $script:Result = 'Timeout'
    $remaining     = [int]$Seconds

    $timer = New-Object System.Windows.Forms.Timer
    $timer.Interval = 1000
    $timer.Add_Tick({
        $remaining--
        if ($remaining -ge 0) {
            $ts = [TimeSpan]::FromSeconds($remaining)
            $labelTime.Text = $ts.ToString("mm\:ss")
            $progress.Value = [math]::Min($remaining,$progress.Maximum)
        } else {
            $timer.Stop()
            $form.Close()
        }
    })

    # Események
    $btnRestart.Add_Click({
        $script:Result = 'Restart'
        $timer.Stop(); $form.Close()
    })
    $btnSnooze.Add_Click({
        $script:Result = "Snooze:$SnoozeMinutes"
        $timer.Stop(); $form.Close()
    })
    $btnCancel.Add_Click({
        $script:Result = 'Cancel'
        $timer.Stop(); $form.Close()
    })

    # Esc = Mégse
    $form.KeyPreview = $true
    $form.Add_KeyDown({ if ($_.KeyCode -eq 'Escape') { $btnCancel.PerformClick() } })

    $form.Add_Shown({
        $labelTime.Text = ([TimeSpan]::FromSeconds($remaining)).ToString("mm\:ss")
        $progress.Value = $remaining
        $timer.Start()
    })

    $null = $form.ShowDialog()
    $timer.Dispose()
    return $script:Result


