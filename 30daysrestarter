# Toast építés/megjelenítés
function Show-Toast { param([string]$Title,[string[]]$BodyLines,[string]$LogoSrc,[string]$HeroSrc,[string]$SnoozeButtonText,[string]$DismissButtonText,[switch]$IncludeSnooze,[switch]$IncludeSettings,[string]$SettingsBtnText,[string]$Audio='ms-winsoundevent:Notification.Default')
  $imgLogo = if($LogoSrc){ "<image placement=""appLogoOverride"" hint-crop=""circle"" src=""$LogoSrc""/>" }
  $imgHero = if($HeroSrc){ "<image placement=""hero"" src=""$HeroSrc""/>" }
  $actions = @()
<#  
if ($IncludeSettings) {
    $actions += @"
<action content="$SettingsBtnText" activationType="protocol" arguments="ms-settings:windowsupdate" />
"@
}
#>
  if($IncludeSnooze)   { $actions += "<action content=""$SnoozeButtonText"" activationType=""system"" arguments=""dismiss"" />" }
  if($DismissButtonText){ $actions += "<action content=""$DismissButtonText"" activationType=""system"" arguments=""dismiss"" />" }
  $actionsXml = if($actions.Count -gt 0){ "<actions>`n  $(($actions -join "`n  "))`n</actions>" } else { '' }
  $bodyXml   = ($BodyLines | ForEach-Object { "<text>$_</text>" }) -join "`n      "
  $xml = @"
<toast activationType="foreground">
  <visual>
    <binding template="ToastGeneric">
      $imgLogo
      <text>$Title</text>
      $bodyXml
      $imgHero
    </binding>
  </visual>
  $actionsXml
  $Audio
</toast>
"@
  $doc = New-WinRTXmlDocument; $doc.LoadXml($xml)
  $ToastMgr = Get-WinRTToastManager; $notifier = $ToastMgr::CreateToastNotifier($AppId)
  $ToastType=[Type]::GetType('Windows.UI.Notifications.ToastNotification, Windows.UI.Notifications, ContentType=WindowsRuntime'); if(-not $ToastType){ throw 'ToastNotification type not available' }
  $toast=[Activator]::CreateInstance($ToastType,$doc)
  $null=$toast.add_Failed({ param($s,$e) Write-Log "Toast Failed: $($e.ErrorCode)" 'ERROR' })
  $notifier.Show($toast)
}

function Schedule-SnoozeToast { param([int]$Hours,[string]$Title,[string[]]$BodyLines,[string]$LogoSrc,[string]$HeroSrc)
  if($Hours -le 0){ return }
  $imgLogo = if($LogoSrc){ "<image placement=""appLogoOverride"" hint-crop=""circle"" src=""$LogoSrc""/>" } else { '' }
  $imgHero = if($HeroSrc){ "<image placement=""hero"" src=""$HeroSrc""/>" } else { '' }
  $bodyXml = ($BodyLines | ForEach-Object { "<text>$_</text>" }) -join "`n      "
  $xml = @"
<toast activationType="foreground">
  <visual>
    <binding template="ToastGeneric">
      $imgLogo
      <text>$Title</text>
      $bodyXml
      $imgHero
    </binding>
  </visual>
  ms-winsoundevent:Notification.Default
</toast>
"@
  $doc = New-WinRTXmlDocument; $doc.LoadXml($xml)
  $scheduledType = Get-WinRTScheduledToast
  $dueTime = (Get-Date).AddHours($Hours)
  #$scheduled = [Activator]::CreateInstance($scheduledType,$doc,$dueTime)
  $scheduled = [Windows.UI.Notifications.ScheduledToastNotification]::new($doc, [DateTimeOffset]$dueTime)
  #$scheduled.Tag = $tag 
  $ToastMgr = Get-WinRTToastManager; $notifier = $ToastMgr::CreateToastNotifier($AppId)
  $notifier.AddToSchedule($scheduled)  
  <#
  Write-Log "DEBUG Scheduled ctor → docType=$($doc.GetType().FullName)"
  Write-Log "DEBUG Scheduled ctor → xmlLength=$($doc.GetXml().Length)"
  Write-Log "DEBUG Scheduled ctor → dueTime=$dueTime"
  #>
  Write-Log "Snooze toast átütemezve: $($dueTime.ToString('yyyy-MM-dd HH:mm:ss'))"
}

