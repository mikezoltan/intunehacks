# Uptime
function Get-UptimeDays { param([int]$TestOverride=-1)
  if($TestOverride -ge 0){ return [double]$TestOverride }
  try{ $os=Get-CimInstance Win32_OperatingSystem; $boot=$os.LastBootUpTime; return (New-TimeSpan -Start $boot -End (Get-Date)).TotalDays }
  catch{ $ticks=[Environment]::TickCount64; return ([TimeSpan]::FromMilliseconds($ticks)).TotalDays }
}
$uptimeDays = [math]::Round((Get-UptimeDays -TestOverride $TestUptimeDays),1)
