# Base64 → PNG fájl (hibabiztos verzió)
function Save-Base64Image {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string]$Base64,

        [Parameter(Mandatory)]
        [string]$FileName
    )

    try {
        # Prefix eltávolítása, ha van (data:image/...;base64,)
        $clean = $Base64 -replace '^data:image\/[a-zA-Z0-9]+;base64,', ''

        # Valódi Base64 ellenőrzés
        if (-not ($clean -match '^[A-Za-z0-9+/=]+$')) {
            Write-Verbose "Save-Base64Image: Érvénytelen Base64 karakterek."
            return $null
        }

        # Dekódolás
        try {
            $bytes = [Convert]::FromBase64String($clean)
        } catch {
            Write-Verbose "Save-Base64Image: Dekódolási hiba. $($_.Exception.Message)"
            return $null
        }

        # Tartós Asset mappa (toast is be tudja olvasni)
        $assetDir = Join-Path $env:ProgramData 'ForceRestart\Assets'

        if (-not (Test-Path $assetDir)) {
            New-Item -Path $assetDir -ItemType Directory -Force | Out-Null
        }

        # Fájlnév teljes útvonallal
        $filePath = Join-Path $assetDir $FileName

        # Írás
        [System.IO.File]::WriteAllBytes($filePath, $bytes)

        # Visszaadás
        return $filePath
    }
    catch {
        Write-Verbose "Save-Base64Image: Váratlan hiba: $($_.Exception.Message)"
        return $null
    }
}

