    $body2 = if($EnforceRestart){ ($T.GraceMsg -f $MandatoryFinalGrace) } else { $T.BodyMandatory2 }
    $lines = @($T.BodyMandatory1,$body2,("Uptime: {0} nap" -f $uptimeDays))
    Show-Toast -Title $T.TitleMandatory -BodyLines $lines -LogoSrc $LogoUri -HeroSrc $HeroUri -DismissButtonText $T.DismissBtn -IncludeSettings -SettingsBtnText $T.SettingsBtn
    if($EnforceRestart){
      Write-Log "Kényszerített restart előkészítése. Deferral: $MandatoryDeferral, FinalGrace: $MandatoryFinalGrace"
      Start-Sleep -Seconds $MandatoryDeferral
      $finalLines = @(($T.GraceMsg -f $MandatoryFinalGrace))
      Show-Toast -Title $T.TitleMandatory -BodyLines $finalLines -LogoSrc $LogoUri -HeroSrc $HeroUri -DismissButtonText $T.DismissBtn
      #Start-Sleep -Seconds $MandatoryFinalGrace
      #Write-Log 'Restart indítása...'; shutdown.exe /r /t 0 /c 'Scheduled restart by ForceRestart script'

    }
  }
#>
}

